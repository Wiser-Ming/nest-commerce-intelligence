# Copy this file to .env and replace every placeholder before starting services.
# Never commit .env or put production credentials in this template.
MYSQL_ROOT_PASSWORD=change-this-local-root-password
MYSQL_APP_PASSWORD=change-this-local-app-password

# Used by conf/app_config.yaml for the language model provider.
LLM_API_KEY=replace-with-your-api-key
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
